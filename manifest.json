{
  "manifest_version": 3,
  "name": "ScheduleRMP",
  "short_name": "ScheduleRMP",
  "version": "2.1.0",
  "description": "Shows detailed professor ratings and exports CUNY schedules to calendar files.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.ratemyprofessors.com/*",
    "https://sb.cunyfirst.cuny.edu/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "ScheduleRMP settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.svg",
      "32": "icons/icon-32.svg"
    }
  },
  "icons": {
    "16": "icons/icon-16.svg",
    "32": "icons/icon-32.svg",
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg",
    "128": "icons/icon-128.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "schedule-rmp@kirklandwaterbot.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://sb.cunyfirst.cuny.edu/*"],
      "css": ["content.css", "calendar/calendar.css"],
      "js": [
        "calendar/schedule-parser.js",
        "calendar/ics-generator.js",
        "calendar/calendar-ui.js",
        "calendar/calendar-export.js",
        "content.js"
      ]
    }
  ]
}
