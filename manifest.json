{
  "manifest_version": 3,
  "name": "CUNY Schedule Professor Ratings",
  "short_name": "CUNY Ratings",
  "version": "2.0.1",
  "description": "Shows Rate My Professors ratings beside instructors in CUNY Schedule Builder.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.ratemyprofessors.com/*",
    "https://sb.cunyfirst.cuny.edu/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "CUNY Schedule Professor Ratings settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.svg",
      "32": "icons/icon-32.svg"
    }
  },
  "icons": {
    "16": "icons/icon-16.svg",
    "32": "icons/icon-32.svg",
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg",
    "128": "icons/icon-128.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cuny-schedule-professor-ratings@kirklandwaterbot.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://sb.cunyfirst.cuny.edu/*"],
      "css": ["content.css"],
      "js": ["content.js"]
    }
  ]
}
